# Resend API key used by /api/audit to email new audit requests (server only)
RESEND_API_KEY=
# Inbox that receives audit requests
AUDIT_TO_EMAIL=
# Optional: n8n / Make / Zapier webhook that also receives each lead (server only)
AUDIT_WEBHOOK_URL=
# Public site URL used for canonical links, sitemap, OG tags and JSON-LD
NEXT_PUBLIC_SITE_URL=
# Optional: sender for audit emails, on a domain verified in Resend
# (defaults to Resend's test sender onboarding@resend.dev)
AUDIT_FROM_EMAIL=
